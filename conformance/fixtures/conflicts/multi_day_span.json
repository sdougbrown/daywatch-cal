    {
      "id": "mtg",
      "label": "Interior",
      "dates": ["2026-04-02"],
      "startTime": "09:00",
      "endTime": "10:00"
    },
    {
      "id": "am4",
      "label": "LastAM",
      "dates": ["2026-04-04"],
      "startTime": "09:00",
      "endTime": "10:00"
    },
    {
      "id": "pm4",
      "label": "LastPM",
      "dates": ["2026-04-04"],
