{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "version": {
      "outputs": ["src/_version.ts"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
